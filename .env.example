# ── Frontend (Vercel) ──────────────────────────────────────────────────────────
# URL of your deployed Render backend (no trailing slash)
VITE_API_URL=https://your-backend.onrender.com

# WalletConnect Cloud project ID (cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=

# Onramp widget origin — sandbox or production
VITE_ONRAMP_WIDGET_BASE_URL=https://onramp-sandbox.arc.io

# ── Backend (Render) ───────────────────────────────────────────────────────────
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
TURSO_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=
VITE_FX_API_KEY=
ONRAMP_API_BASE_URL=https://api-test.circle.com
ONRAMP_REFERRER_DOMAIN=your-app.vercel.app
